# 物业管理台账 PHP 版 · Apache 安全配置（infinityfree htdocs 生效）

# 禁止直接访问敏感文件：配置 / 建表脚本 / 安装向导 / 临时备份 / 说明
<FilesMatch "^(config\.php|schema\.sql|setup\.php|backup\.php|_backup_.*\.sql|README\.md)$">
  Require all denied
</FilesMatch>

# 禁止目录列表
Options -Indexes

# 基础安全响应头
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "same-origin"
</IfModule>
